# ---- Solana ----
# RPC endpoint. A dedicated provider (Helius, QuickNode, Triton) is strongly recommended
# over the public mainnet RPC for reliability and rate limits.
RPC_URL=https://api.mainnet-beta.solana.com

# Wallet private key, base58-encoded (Phantom export format).
# OPTIONAL for the scanner — only required once swaps/deposits are enabled.
# NEVER commit a real key. Keep DRY_RUN=true until you intend to trade live.
PRIVATE_KEY=

# ---- Jupiter (swaps / pricing) ----
# Quote API V6 (quote-api.jup.ag/v6) is deprecated. Use api.jup.ag with a free key
# generated at https://portal.jup.ag. Paths are unchanged; only the host changes.
JUPITER_BASE_URL=https://api.jup.ag
JUPITER_API_KEY=

# ---- Safety ----
# When true (default), no transactions are sent — screening and simulation only.
DRY_RUN=true

# ---- Scanner thresholds ----
MIN_TVL_USD=10000
MIN_VOLUME_TVL_RATIO=0.5
BIN_STEP_MIN=10
BIN_STEP_MAX=100
TOP_N=3
# Pools are fetched largest-first; this bounds how many to pull before filtering
# (the API hosts 100k+ pools — candidates cluster at the top).
MAX_POOLS_SCAN=500

# ---- Swap safety ----
# Max slippage in basis points. Hard-clamped to 100 (1%) in code regardless of this value.
MAX_SLIPPAGE_BPS=100

# ---- Telegram (monitoring & control) ----
# When true, starts a Telegram bot for /scan, /status, etc. and pushes alerts.
# When false (default), the app runs as a one-shot scan and exits.
TELEGRAM_ENABLED=false
# Create a bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs allowed to use the bot (find yours via @userinfobot).
# Required when TELEGRAM_ENABLED=true — the bot ignores everyone else.
TELEGRAM_ALLOWED_CHAT_IDS=
# Auto-scan interval in minutes that pushes results to allowed chats. 0 = disabled.
SCAN_INTERVAL_MINUTES=0
